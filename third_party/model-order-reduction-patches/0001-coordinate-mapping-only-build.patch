--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -4,6 +4,34 @@
 
 include(CMakeDependentOption)
 include(cmake/environment.cmake)
+
+# Coordinate reduction only: the Cosserat pipeline has no hyper-reduced force field.
+option(MOR_MAPPING_ONLY "Build the official coordinate mapping without ECSW/contact" OFF)
+if(MOR_MAPPING_ONLY)
+    find_package(Sofa.Core REQUIRED)
+    sofa_find_package(Sofa.Component.Mapping.Linear REQUIRED)
+    sofa_find_package(Sofa.Component.Topology.Container.Grid REQUIRED)
+    set(MOR_SRC "src/ModelOrderReduction")
+    add_library(${PROJECT_NAME} SHARED
+        ${MOR_SRC}/initModelOrderReduction.cpp
+        ${MOR_SRC}/component/loader/MatrixLoader.cpp
+        ${MOR_SRC}/component/mapping/ModelOrderReductionMapping.cpp
+        ${MOR_SRC}/config.h.in)
+    target_compile_definitions(${PROJECT_NAME} PRIVATE
+        SOFA_BUILD_MODELORDERREDUCTION MOR_MAPPING_ONLY)
+    target_link_libraries(${PROJECT_NAME} PUBLIC Sofa.Core
+        Sofa.Component.Mapping.Linear Sofa.Component.Topology.Container.Grid)
+    set_target_properties(${PROJECT_NAME} PROPERTIES
+        INSTALL_RPATH "$ORIGIN;$ORIGIN/../../../lib")
+    sofa_create_package_with_targets(
+        PACKAGE_NAME ModelOrderReduction PACKAGE_VERSION ${PROJECT_VERSION}
+        TARGETS ${PROJECT_NAME} AUTO_SET_TARGET_PROPERTIES
+        INCLUDE_SOURCE_DIR "src" INCLUDE_INSTALL_DIR "ModelOrderReduction"
+        RELOCATABLE "plugins")
+    install(DIRECTORY python/mor DESTINATION lib/python3/site-packages)
+    install(FILES LICENSE README.md DESTINATION .)
+    return()
+endif()
 
 # Specify all required packages
 find_package(Sofa.Core REQUIRED)
