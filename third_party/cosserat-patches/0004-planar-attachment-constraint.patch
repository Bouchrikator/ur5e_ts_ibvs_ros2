@@ -0,0 +1,78 @@
+/******************************************************************************
+*                 SOFA, Simulation Open-Framework Architecture                *
+*                    (c) 2006 INRIA, USTL, UJF, CNRS, MGH                     *
+*                                                                             *
+* This program is free software; you can redistribute it and/or modify it     *
+* under the terms of the GNU Lesser General Public License as published by    *
+* the Free Software Foundation; either version 2.1 of the License, or (at     *
+* your option) any later version.                                             *
+******************************************************************************/
+#pragma once
+
+#include <Cosserat/config.h>
+
+#include <sofa/core/behavior/LagrangianConstraint.h>
+#include <sofa/defaulttype/RigidTypes.h>
+#include <sofa/type/Quat.h>
+#include <sofa/type/Vec.h>
+
+namespace Cosserat::constraint
+{
+
+/**
+ * Bilateral attachment of one Rigid3 frame to a prescribed pose, restricted to the three
+ * in-plane directions of a fixture plane. The rows are the planar residuals
+ *
+ *   C = [ (p - p_target) . e_x,  (p - p_target) . e_y,  yaw(q q_target^-1) about n ]
+ *
+ * with (e_x, e_y, n) the axes of `planeOrientation`, so the solver sees exactly three rows
+ * (matrix, violation, 3x3 block resolution and stored multipliers all use the same three).
+ * `lambda` holds the multipliers of the last solve as SOFA's constraint solver returns them.
+ */
+template <class DataTypes>
+class PlanarAttachmentConstraint : public sofa::core::behavior::LagrangianConstraint<DataTypes>
+{
+public:
+    SOFA_CLASS(SOFA_TEMPLATE(PlanarAttachmentConstraint, DataTypes),
+               SOFA_TEMPLATE(sofa::core::behavior::LagrangianConstraint, DataTypes));
+
+    using Inherit = sofa::core::behavior::LagrangianConstraint<DataTypes>;
+    using Coord = typename DataTypes::Coord;
+    using Deriv = typename DataTypes::Deriv;
+    using Real = typename DataTypes::Real;
+    using DataVecCoord = typename Inherit::DataVecCoord;
+    using DataVecDeriv = typename Inherit::DataVecDeriv;
+    using DataMatrixDeriv = typename Inherit::DataMatrixDeriv;
+    using Vec3 = sofa::type::Vec3;
+
+    sofa::Data<unsigned int> d_index;
+    sofa::Data<Coord> d_target;
+    sofa::Data<Deriv> d_targetVelocity;
+    sofa::Data<sofa::type::Quat<SReal>> d_planeOrientation;
+    sofa::Data<bool> d_active;
+    sofa::Data<Vec3> d_violation;
+    sofa::Data<Vec3> d_lambda;
+
+    void buildConstraintMatrix(const sofa::core::ConstraintParams* cParams, DataMatrixDeriv& c,
+                               unsigned int& cIndex, const DataVecCoord& x) override;
+    void getConstraintViolation(const sofa::core::ConstraintParams* cParams,
+                                sofa::linearalgebra::BaseVector* resV, const DataVecCoord& x,
+                                const DataVecDeriv& v) override;
+    void getConstraintResolution(const sofa::core::ConstraintParams* cParams,
+                                 std::vector<sofa::core::behavior::ConstraintResolution*>& resTab,
+                                 unsigned int& offset) override;
+    void storeLambda(const sofa::core::ConstraintParams* cParams, sofa::core::MultiVecDerivId res,
+                     const sofa::linearalgebra::BaseVector* lambda) override;
+
+protected:
+    PlanarAttachmentConstraint();
+
+    unsigned int m_cid{0};
+    bool m_built{false};
+};
+
+#if !defined(SOFA_COSSERAT_CPP_PlanarAttachmentConstraint)
+extern template class SOFA_COSSERAT_API PlanarAttachmentConstraint<sofa::defaulttype::Rigid3Types>;
+#endif
+
+} // namespace Cosserat::constraint
