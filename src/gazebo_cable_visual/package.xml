<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_cable_visual</name>
  <version>0.2.0</version>
  <description>Visual-only cable in Gazebo, driven by SOFA centerline frames (native gz-transport, no physics, no collision)</description>
  <maintainer email="miko.boucherika@gmail.com">Bouchrikator</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
