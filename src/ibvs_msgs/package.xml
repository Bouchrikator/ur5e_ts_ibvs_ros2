<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ibvs_msgs</name>
  <version>1.0.0</version>
  <description>
    Interface definitions for the IBVS pipeline: the FeatureTarget message
    published by the perception node and the SolveMPC service used by the
    QMM-MPC controller to delegate the online SDP to the Python solver node.
  </description>
  <maintainer email="boucherikator@todo.todo">boucherikator</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
