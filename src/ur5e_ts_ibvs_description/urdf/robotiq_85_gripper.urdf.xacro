<?xml version="1.0"?>
<!--
  Robotiq 85 (2F-85) Gripper — ported for Gazebo Harmonic (gz-sim)
  Macro attaches to a parent link via a fixed joint.

  Changes from Gazebo Classic version:
  - Mesh URIs use package:// (still valid in gz-sim via resource_system)
  - Mimic joints: handled natively by URDF <mimic> tags in gz-sim8
  - Removed Classic-only plugins (mimic_joint_plugin, grasp_fix)
  - Gazebo surface properties use <gazebo> tags (converted by URDF→SDF)
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_85_gripper">

  <xacro:property name="robotiq_mesh_path" value="file://$(find ur5e_ts_ibvs_description)/meshes/robotiq_85"/>

  <xacro:macro name="robotiq_85_gripper" params="prefix parent *origin">

    <!-- ============ Base ============ -->
    <joint name="${prefix}gripper_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${prefix}gripper_base_link">
      <visual>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/visual/robotiq_85_base_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/collision/robotiq_85_base_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.636951"/>
        <origin xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.000380" ixy="0.0" ixz="0.0"
                 iyy="0.001110" iyz="0.0" izz="0.001171"/>
      </inertial>
    </link>

    <!-- ============ Finger 1 — Knuckle (Driven) ============ -->
    <joint name="${prefix}gripper_finger1_joint" type="revolute">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_finger1_knuckle_link"/>
      <axis xyz="0 0 1"/>
      <origin rpy="${pi} 0.0 0.0" xyz="0.05490451627 0.03060114443 0.0"/>
      <limit lower="0.0" upper="0.804" velocity="2.0" effort="1000"/>
      <dynamics damping="10.0" friction="1.0"/>
    </joint>

    <link name="${prefix}gripper_finger1_knuckle_link">
      <visual>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/visual/robotiq_85_knuckle_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/collision/robotiq_85_knuckle_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.018491"/>
        <origin xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.000009" ixy="0.0" ixz="0.0"
                 iyy="0.000009" iyz="0.0" izz="0.000006"/>
      </inertial>
    </link>

    <!-- ============ Finger 2 — Knuckle (Mimic) ============ -->
    <joint name="${prefix}gripper_finger2_joint" type="revolute">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_finger2_knuckle_link"/>
      <axis xyz="0 0 1"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.05490451627 -0.03060114443 0.0"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="1000"/>
      <dynamics damping="10.0" friction="1.0"/>
      <mimic joint="${prefix}gripper_finger1_joint"/>
    </joint>

    <link name="${prefix}gripper_finger2_knuckle_link">
      <visual>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/visual/robotiq_85_knuckle_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/collision/robotiq_85_knuckle_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.018491"/>
        <origin xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.000009" ixy="0.0" ixz="0.0"
                 iyy="0.000009" iyz="0.0" izz="0.000006"/>
      </inertial>
    </link>

    <!-- ============ Finger 1 — Finger Link (Fixed to Knuckle) ============ -->
    <joint name="${prefix}gripper_finger1_finger_joint" type="fixed">
      <parent link="${prefix}gripper_finger1_knuckle_link"/>
      <child link="${prefix}gripper_finger1_finger_link"/>
      <origin xyz="-0.00408552455 -0.03148604435 0.0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_finger1_finger_link">
      <visual>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/visual/robotiq_85_finger_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/collision/robotiq_85_finger_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.027309"/>
        <origin xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.000003" ixy="-0.000002" ixz="0.0"
                 iyy="0.000021" iyz="0.0" izz="0.000020"/>
      </inertial>
    </link>

    <!-- ============ Finger 2 — Finger Link (Fixed to Knuckle) ============ -->
    <joint name="${prefix}gripper_finger2_finger_joint" type="fixed">
      <parent link="${prefix}gripper_finger2_knuckle_link"/>
      <child link="${prefix}gripper_finger2_finger_link"/>
      <origin xyz="-0.00408552455 -0.03148604435 0.0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_finger2_finger_link">
      <visual>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/visual/robotiq_85_finger_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/collision/robotiq_85_finger_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.027309"/>
        <origin xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.000003" ixy="-0.000002" ixz="0.0"
                 iyy="0.000021" iyz="0.0" izz="0.000020"/>
      </inertial>
    </link>

    <!-- ============ Finger 1 — Inner Knuckle (Mimic) ============ -->
    <joint name="${prefix}gripper_finger1_inner_knuckle_joint" type="continuous">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_finger1_inner_knuckle_link"/>
      <axis xyz="0 0 1"/>
      <origin xyz="0.06142 0.0127 0" rpy="${pi} 0.0 0.0"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
      <dynamics damping="10.0" friction="1.0"/>
      <mimic joint="${prefix}gripper_finger1_joint" offset="0"/>
    </joint>

    <link name="${prefix}gripper_finger1_inner_knuckle_link">
      <visual>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/visual/robotiq_85_inner_knuckle_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/collision/robotiq_85_inner_knuckle_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.029951"/>
        <origin xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.000039" ixy="0.0" ixz="0.0"
                 iyy="0.000005" iyz="0.0" izz="0.000035"/>
      </inertial>
    </link>

    <!-- ============ Finger 2 — Inner Knuckle (Mimic) ============ -->
    <joint name="${prefix}gripper_finger2_inner_knuckle_joint" type="continuous">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_finger2_inner_knuckle_link"/>
      <axis xyz="0 0 1"/>
      <origin xyz="0.06142 -0.0127 0" rpy="0 0 0"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
      <dynamics damping="10.0" friction="1.0"/>
      <mimic joint="${prefix}gripper_finger1_joint" offset="0"/>
    </joint>

    <link name="${prefix}gripper_finger2_inner_knuckle_link">
      <visual>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/visual/robotiq_85_inner_knuckle_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/collision/robotiq_85_inner_knuckle_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.029951"/>
        <origin xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.000039" ixy="0.0" ixz="0.0"
                 iyy="0.000005" iyz="0.0" izz="0.000035"/>
      </inertial>
    </link>

    <!-- ============ Finger 1 — Finger Tip (Mimic × -1) ============ -->
    <joint name="${prefix}gripper_finger1_finger_tip_joint" type="continuous">
      <parent link="${prefix}gripper_finger1_inner_knuckle_link"/>
      <child link="${prefix}gripper_finger1_finger_tip_link"/>
      <axis xyz="0 0 1"/>
      <origin xyz="0.04303959807 -0.03759940821 0.0" rpy="0.0 0.0 0.0"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
      <dynamics damping="10.0" friction="1.0"/>
      <mimic joint="${prefix}gripper_finger1_joint" multiplier="-1"/>
    </joint>

    <link name="${prefix}gripper_finger1_finger_tip_link">
      <visual>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/visual/robotiq_85_finger_tip_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/collision/robotiq_85_finger_tip_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.019555"/>
        <origin xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.000002" ixy="0.0" ixz="0.0"
                 iyy="0.000005" iyz="0.0" izz="0.000006"/>
      </inertial>
    </link>

    <!-- ============ Finger 2 — Finger Tip (Mimic × -1) ============ -->
    <joint name="${prefix}gripper_finger2_finger_tip_joint" type="continuous">
      <parent link="${prefix}gripper_finger2_inner_knuckle_link"/>
      <child link="${prefix}gripper_finger2_finger_tip_link"/>
      <axis xyz="0 0 1"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.04303959807 -0.03759940821  0.0"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
      <dynamics damping="10.0" friction="1.0"/>
      <mimic joint="${prefix}gripper_finger1_joint" multiplier="-1"/>
    </joint>

    <link name="${prefix}gripper_finger2_finger_tip_link">
      <visual>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/visual/robotiq_85_finger_tip_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${robotiq_mesh_path}/collision/robotiq_85_finger_tip_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.019555"/>
        <origin xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.000002" ixy="0.0" ixz="0.0"
                 iyy="0.000005" iyz="0.0" izz="0.000006"/>
      </inertial>
    </link>


  </xacro:macro>
</robot>
