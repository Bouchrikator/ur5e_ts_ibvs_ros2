<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sofa_ros2_adapter</name>
  <version>0.1.0</version>
  <description>Runs the SOFA Cosserat cable in-process with rclpy: TF-driven boundary, publishes centerline frames and markers</description>
  <maintainer email="miko.boucherika@gmail.com">Bouchrikator</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>cable_msgs</exec_depend>
  <exec_depend>cable_identification</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
